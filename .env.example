# ===== LINE =====
LINE_CHANNEL_ACCESS_TOKEN=ここにLINEチャネルアクセストークン
LINE_CHANNEL_SECRET=ここにLINEチャネルシークレット

# ===== Neon PostgreSQL =====
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ===== OpenRouter =====
OPENROUTER_API_KEY=ここにOpenRouter APIキー
OPENROUTER_MODEL=モデル名

# ===== Discord =====
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/XXXXXXXX


DISCORD_MAX_UPLOAD_MB=9.5

# ===== Weather (JMA area code) =====
WEATHER_AREA_CODE=130000

# ===== Admins =====
# カンマ区切りで複数指定可能
ADMIN_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Uyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ===== Server =====
PORT=3000
TIMEZONE=Asia/Tokyo

# ===== Compression =====
# 画像の最大長辺。大きすぎる画像を縮小する。
IMAGE_MAX_DIMENSION=2560

# 動画圧縮の最大長辺。
VIDEO_MAX_DIMENSION=1280

# 動画の最大秒数。0なら制限なし。
VIDEO_MAX_SECONDS=0
